# IMAP connection settings
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password

# Optional: comma-separated mailbox names to treat as "safe" for delete/move
# operations. If unset, all mailboxes are allowed.
# IMAP_ALLOWED_MAILBOXES=INBOX,Archive

# Optional: cap on how many messages a single search/list call can return
IMAP_MAX_RESULTS=50
